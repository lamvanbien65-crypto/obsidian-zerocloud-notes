  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.24.0",
    "eslint": "^10.9.1",
    "obsidian": "1.7.2",
    "tslib": "^2.8.0",
    "typescript": "5.6.3"
  }
}