{
  "name": "obsidian-zerocloud-notes",
  "version": "0.1.0",
  "description": "ZeroCloud Notes: clip Xiaohongshu image-text notes & videos to local Markdown notes — 100% offline, zero API cost",
  "main": "main.js",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node esbuild.config.mjs",
    "sync:python": "node build.mjs sync-python",
